APP_ENV=dev
APP_SECRET=changeme_in_env_local

# MySQL / MariaDB
DATABASE_URL="mysql://root:@127.0.0.1:3306/forever?serverVersion=8.0.32&charset=utf8mb4"

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme_in_env_local

# CORS — frontend Vite
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

