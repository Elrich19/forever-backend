# Use the front controller as index file. It serves as a fallback solution when
# every other rewrite/redirect fails (e.g. in an aliased environment without
# mod_rewrite). Additionally, this reduces the matching process for the
# start page (path "/") because it doesn't have to be rewritten to "/index.php".
DirectoryIndex index.php

# By default, Apache does not evaluate symbolic links if you did not enable this
# feature in your server configuration. Uncomment the following line if you
# install assets as symlinks or if you experience problems related to symlinks
# when compiling LESS/Sass/CoffeScript assets.
# Options +FollowSymlinks

# Disabling MultiViews prevents unwanted negotiation, e.g. "/index" should not resolve
# to the front controller "/index.php" but be rewritten to "/index.php/index".
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Detecte automatiquement le sous-dossier (utile sur hébergement mutualisé)
    RewriteCond %{REQUEST_URI}::$1 ^(/.+)/(.*)::\2$
    RewriteRule ^(.*) - [E=BASE:%1]

    # Force le passage du header Authorization à PHP (souvent stripé par Apache + PHP-FPM)
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Empêche d'accéder à index.php directement avec le chemin (évite contenu dupliqué)
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Si le fichier demandé existe physiquement (CSS, image, etc.), on le sert tel quel
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Sinon, on délègue tout à index.php (front controller Symfony)
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        # Si mod_rewrite n'est PAS dispo : fallback simple via mod_alias
        # /api/auth/register devient /index.php/api/auth/register
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# CORS : laisse Symfony (NelmioCorsBundle) gérer, mais permet à OPTIONS de passer
<IfModule mod_headers.c>
    # Si tu veux pouvoir lire le header Authorization côté JS, décommente :
    # Header always set Access-Control-Expose-Headers "Authorization"
</IfModule>
